{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["jest"],
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/**/__tests__/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "jest.setup.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": ["lib", "coverage", "example"]
}
